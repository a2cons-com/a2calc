# Copy to secrets/testflight.env (git-ignored) and fill in. Every value can
# also come from the environment.

# App Store Connect API key (App Store Connect > Users and Access > Integrations)
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8

# Manual signing for the export: an installed App Store provisioning profile
# (node scripts/asc-profiles.mjs issues and installs it) and, when the
# keychain has more than one, the SHA-1 of the Apple Distribution identity.
DIST_PROFILE="A2 Calc App Store"
DIST_CERT=

# Optional: a separate keychain holding the distribution identity, and the
# NAME of the environment variable that holds its password.
SIGN_KEYCHAIN=
SIGN_KEYCHAIN_PASSWORD_VAR=
