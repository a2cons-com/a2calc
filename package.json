{
	"name": "a2calc",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"config": "node scripts/gen-config.mjs",
		"icons": "node scripts/gen-icons.mjs",
		"cap:sync": "npm run config && npm run build && cap sync ios",
