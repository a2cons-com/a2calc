<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- The App Sandbox the Mac App Store requires. Nothing else: the app uses
     no network, files or hardware (links open in the default browser). -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
