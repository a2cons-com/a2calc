{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A2 Calc",
  "version": "0.1.0",
  "identifier": "com.a2cons.calc",
  "build": {
    "frontendDist": "../../build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
